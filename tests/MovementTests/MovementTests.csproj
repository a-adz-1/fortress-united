<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the engine-free Core code outside Unity (tests/Core builds the
       same Assets/ sources the game uses). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/FortressUnited.Core.csproj" />
  </ItemGroup>
</Project>
